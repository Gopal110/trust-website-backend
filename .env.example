PORT=5000
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/trust_db?retryWrites=true&w=majority
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=your-32-char-encryption-key-here
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Set to your Vercel frontend URL so CORS allows it on Render
FRONTEND_URL=https://your-project.vercel.app
# Optionally add more origins as comma-separated list
# ALLOWED_ORIGINS=https://custom-domain.com,https://other.vercel.app